# CompTIA Domain-Scoped AI Learning Agent - Environment Configuration Example
# Copy this file to .env and update values for your environment
# IMPORTANT: Never commit .env to version control - only commit .env.example

# Application Environment
# Set to 'development' for local development or 'production' for deployment
FLASK_ENV=development

# Application Secret Key
# PRODUCTION: Generate a strong random key using: python -c "import secrets; print(secrets.token_hex(32))"
# DEVELOPMENT: Can use the default from the app, but best practice is to set it
SECRET_KEY=your_secret_key_here

# Database URL
# Examples:
#   SQLite (development):  sqlite:///project.db
#   PostgreSQL:            postgresql://user:password@localhost:5432/comptia_db
#   MySQL:                 mysql+pymysql://user:password@localhost:3306/comptia_db
# Default: sqlite:///project.db (used if not set)
DATABASE_URL=sqlite:///project.db

# Server Configuration
# Port number for development server (default: 5000)
PORT=5000

# Debug Mode
# Set to True for automatic reload and debug toolbar in development
# NEVER enable in production
DEBUG=False
